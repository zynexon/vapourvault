<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VaporVault_App.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VaporVault_App.Pages"
    xmlns:converters="using:VaporVault_App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid Padding="36,24,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Scan for Leftovers"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Find leftover files from apps you've already uninstalled through Windows Settings."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Scan Button + Status -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ScanButton"
                    Content="Scan Now"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ScanButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBool}}"
                    MinWidth="120" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="StatusText"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText"
                           Text="{x:Bind ViewModel.ScanSummary, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- Results List -->
        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.OrphanedApps, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16" Margin="0,4,0,4"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- App Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding AppName}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <!-- Size Badge -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4" Padding="8,2,8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalSizeBytes, Converter={StaticResource FileSizeConverter}}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>

                        <!-- Card Description -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding CardDescription}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,4"
                                   TextWrapping="Wrap" />

                        <!-- Folder Paths (collapsed by default) + Quarantine Button -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Quarantine"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{Binding}"
                                    Click="QuarantineButton_Click"
                                    MinWidth="100" />
                            <Button Content="Show Paths"
                                    Click="ShowPathsButton_Click"
                                    Tag="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
