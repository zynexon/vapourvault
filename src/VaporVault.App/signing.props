<!--
  VaporVault MSIX Code Signing Configuration
  ===========================================

  This file wires MSIX package signing into the build pipeline.

  How it works:
  - Debug/development: Uses the self-signed PFX at certs/VaporVault-Dev.pfx
    (generated by scripts/New-DevSigningCert.ps1). If missing, a clear error
    message tells you how to create it.

  - Release/CI: Requires the VaporVaultSigningCertFile property to be set to
    a real OV code signing certificate. The build FAILS LOUDLY if this is
    missing, rather than silently falling back to self-signed.

  To set the production cert in CI:
    dotnet publish -c Release -p:VaporVaultSigningCertFile=path\to\real-cert.pfx
                                -p:VaporVaultSigningCertPassword=<secret>

  Or set it in a CI-specific .props file that's not checked into source control.
-->
<Project>
  <PropertyGroup>
    <!--
      Default dev certificate path (relative to VaporVault.App.csproj).
      Override via -p:VaporVaultSigningCertFile=... on the command line.
    -->
    <VaporVaultSigningCertFile Condition="'$(VaporVaultSigningCertFile)' == ''">$(MSBuildThisFileDirectory)..\certs\VaporVault-Dev.pfx</VaporVaultSigningCertFile>
    <VaporVaultSigningCertPassword Condition="'$(VaporVaultSigningCertPassword)' == ''">VaporVaultDev</VaporVaultSigningCertPassword>
  </PropertyGroup>

  <!--
    Release builds: FAIL if no real certificate is provided.
    The self-signed dev cert must NOT be used for release builds.
  -->
  <Target Name="_ValidateSigningCertificate" BeforeTargets="GenerateAppxPackageRecipe" Condition="'$(Configuration)' == 'Release'">
    <Error
      Condition="'$(VaporVaultSigningCertFile)' == '' OR !Exists('$(VaporVaultSigningCertFile)')"
      Text="
======================================================================
RELEASE BUILD ERROR: No code signing certificate found.

VaporVault release builds require a real OV code signing certificate.
Self-signed certificates are not acceptable for distribution.

To fix:
  1. Obtain an OV certificate from a CA (DigiCert, Sectigo, etc.)
  2. Pass it to the build:
     dotnet publish -c Release -p:VaporVaultSigningCertFile=path\to\cert.pfx ^
                                -p:VaporVaultSigningCertPassword=SECRET

Or set VaporVaultSigningCertFile in your CI pipeline environment.
======================================================================
" />

    <!-- Also fail if someone is using the dev cert for a Release build -->
    <Error
      Condition="$(VaporVaultSigningCertFile.EndsWith('VaporVault-Dev.pfx'))"
      Text="
======================================================================
RELEASE BUILD ERROR: Development certificate detected.

You are using the self-signed development certificate for a Release build.
This will show 'Unknown Publisher' warnings and won't build SmartScreen trust.

Use a real OV code signing certificate for Release builds.
======================================================================
" />
  </Target>

  <!--
    Development builds: warn (but don't fail) if the dev cert is missing.
    This lets new contributors know they need to run the cert script.
  -->
  <Target Name="_CheckDevCertificate" BeforeTargets="GenerateAppxPackageRecipe" Condition="'$(Configuration)' != 'Release'">
    <Warning
      Condition="!Exists('$(VaporVaultSigningCertFile)')"
      Text="
Development signing certificate not found at: $(VaporVaultSigningCertFile)
Run scripts\New-DevSigningCert.ps1 (as Administrator) to generate one.
The MSIX package will not be signed until this is done.
" />
  </Target>

  <!--
    Wire the certificate into MSIX signing properties.
    These are the standard MSBuild properties that the MSIX tooling reads.
  -->
  <PropertyGroup Condition="Exists('$(VaporVaultSigningCertFile)')">
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>$(VaporVaultSigningCertFile)</PackageCertificateKeyFile>
    <PackageCertificatePassword>$(VaporVaultSigningCertPassword)</PackageCertificatePassword>
  </PropertyGroup>

  <PropertyGroup Condition="!Exists('$(VaporVaultSigningCertFile)')">
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
</Project>
